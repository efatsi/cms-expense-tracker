<div class="mb-6">
  <h1 class="text-2xl font-serif font-semibold">Bulk Upload Receipts</h1>
  <p class="text-gray-500 text-sm mt-1">Drop receipt images, PDFs, or zip files — each file becomes one receipt queued for AI analysis.</p>
</div>

<% if flash[:alert] %>
  <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-md text-red-700 text-sm"><%= flash[:alert] %></div>
<% end %>

<div class="bg-white rounded-lg border border-gray-200 p-6 max-w-lg">
  <%= form_with url: bulk_upload_receipts_path, method: :post, multipart: true,
                data: { controller: "bulk-drop", bulk_drop_upload_url_value: bulk_upload_single_receipts_path } do |f| %>
    <div class="space-y-4">
      <div>
        <%= f.label :user_email, "User Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <% if current_user.admin? %>
          <%= f.select :user_email,
                @users.map { |u| ["#{u.name} (#{u.email})", u.email] },
                { include_blank: "Select a user..." },
                class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-green-camp" %>
        <% else %>
          <input type="hidden" name="user_email" value="<%= current_user.email %>">
          <p class="text-sm text-gray-600 px-1"><%= current_user.name %> (<%= current_user.email %>)</p>
        <% end %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Files</label>

        <div data-bulk-drop-target="zone"
             data-action="dragover->bulk-drop#dragover dragleave->bulk-drop#dragleave drop->bulk-drop#drop click->bulk-drop#browse"
             class="border-2 border-dashed border-gray-300 rounded-md px-4 py-6 text-center transition-colors cursor-pointer hover:border-green-camp hover:bg-green-50">
          <input type="file" name="files[]" multiple accept="image/*,.pdf,.zip"
                 data-bulk-drop-target="input"
                 data-action="change->bulk-drop#inputChanged"
                 class="sr-only">
          <div data-bulk-drop-target="empty">
            <svg class="mx-auto mb-2 text-gray-400" style="width:1.5rem;height:1.5rem" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 16.5V19a2 2 0 002 2h14a2 2 0 002-2v-2.5M16 12l-4-4m0 0l-4 4m4-4v12"/>
            </svg>
            <p class="text-sm text-gray-500">Drop files here or click to browse</p>
            <p class="text-xs text-gray-400 mt-1">Images, PDFs, or zip files — zips are unpacked automatically</p>
          </div>
        </div>

        <div data-bulk-drop-target="list" class="mt-2 border border-gray-100 rounded-md divide-y divide-gray-100 empty:hidden"></div>
      </div>

      <div class="pt-2">
        <%= f.submit "Upload & Queue Analysis",
              data: { bulk_drop_target: "submit" },
              disabled: true,
              class: "bg-green-camp text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-green-dark cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" %>
        <%= link_to "Cancel", receipts_path, class: "ml-3 text-sm text-gray-500 hover:text-gray-700" %>
      </div>
    </div>
  <% end %>
</div>
