<div data-controller="file-drop">
  <div data-file-drop-target="modal"
       class="fixed inset-0 z-50 flex items-center justify-center hidden"
       style="background: rgba(0,0,0,0.4);">
    <div class="bg-white rounded-xl shadow-xl px-10 py-8 flex flex-col items-center gap-4 max-w-sm w-full mx-4">
      <svg class="animate-spin text-green-camp" style="width:2rem;height:2rem" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
      <p class="font-serif font-semibold text-lg text-gray-800">Analyzing your receipt…</p>
      <p class="text-sm text-gray-500 text-center">Extracting vendor, date, and expense details.</p>
      <button type="button" data-action="click->file-drop#cancel"
              class="mt-2 text-sm text-gray-500 hover:text-gray-800 border border-gray-300 rounded-md px-4 py-2 hover:bg-gray-50 transition-colors">
        Cancel
        <span class="block text-xs text-gray-400 font-normal">Want to categorize yourself?</span>
      </button>
    </div>
  </div>

<%= form_with model: receipt, data: { controller: "expense-form" } do |f| %>
  <% if receipt.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-md text-sm mb-4">
      <ul class="list-disc pl-4">
        <% receipt.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-4">
    <h2 class="font-semibold mb-4">Receipt Details</h2>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :vendor, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :vendor, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-camp", required: true %>
      </div>
      <div>
        <%= f.label :expense_date, "Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :expense_date, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-camp", required: true %>
      </div>
      <div>
        <%= f.label :payment_method_id, "Payment Method", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :payment_method_id, PaymentMethod.order(:name), :id, :display_name,
              { prompt: "Select payment method" },
              class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-camp" %>
      </div>
      <div>
        <%= f.label :file, "Receipt File", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <div data-file-drop-target="zone"
             data-action="dragover->file-drop#dragover dragleave->file-drop#dragleave drop->file-drop#drop"
             class="border-2 border-dashed border-gray-300 rounded-md px-4 py-5 text-center transition-colors cursor-pointer"
             onclick="this.querySelector('input[type=file]').click()">
          <svg class="mx-auto mb-2 text-gray-400 pointer-events-none" style="width:1.5rem;height:1.5rem" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 16.5V19a2 2 0 002 2h14a2 2 0 002-2v-2.5M16 12l-4-4m0 0l-4 4m4-4v12"/>
          </svg>
          <span data-file-drop-target="label" class="text-sm text-gray-500 pointer-events-none">Drop file here or click to browse</span>
          <%= f.file_field :file, accept: "image/*,.pdf",
                data: { file_drop_target: "input", action: "change->file-drop#fileChanged" },
                class: "sr-only" %>
        </div>
      </div>
      <div class="col-span-2">
        <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :notes, rows: 2, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-camp" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-4">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold">Expenses</h2>
      <button type="button" data-action="expense-form#addRow" class="text-sm text-green-camp hover:text-green-dark font-medium">+ Add Expense</button>
    </div>

    <div data-expense-form-target="rows">
      <%= f.fields_for :expenses do |ef| %>
        <%= render "expense_row", ef: ef %>
      <% end %>
    </div>

    <template data-expense-form-target="template">
      <div class="expense-row grid grid-cols-12 gap-2 items-start mb-2">
        <div class="col-span-3">
          <select name="receipt[expenses_attributes][NEW_INDEX][expense_category_id]" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm">
            <option value="">Category</option>
            <%= grouped_expense_category_options %>
          </select>
        </div>
        <div class="col-span-6">
          <input type="text" name="receipt[expenses_attributes][NEW_INDEX][description]" placeholder="Description" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm">
        </div>
        <div class="col-span-2">
          <input type="number" name="receipt[expenses_attributes][NEW_INDEX][amount]" placeholder="0.00" step="0.01" min="0.01" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm">
        </div>
        <div class="col-span-1 flex justify-center pt-2">
          <button type="button" data-action="expense-form#removeRow" class="text-red-400 hover:text-red-600 text-lg leading-none">&times;</button>
        </div>
      </div>
    </template>
  </div>

  <% if receipt.file.attached? %>
    <div class="bg-white rounded-lg border border-gray-200 p-6 mb-4">
      <h2 class="font-semibold mb-3">Attached Receipt</h2>
      <% if receipt.file.image? %>
        <%= image_tag receipt.file, class: "max-w-md rounded border" %>
      <% elsif receipt.file.content_type == "application/pdf" %>
        <iframe src="<%= rails_blob_path(receipt.file, disposition: "inline") %>#navpanes=0"
                class="w-full rounded border border-gray-200"
                style="height: 700px;"
                title="Receipt PDF"></iframe>
      <% end %>
    </div>
  <% end %>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", receipts_path, class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-900" %>
    <%= f.submit class: "bg-green-camp text-white px-6 py-2 rounded-md text-sm font-medium hover:bg-green-dark cursor-pointer" %>
  </div>
<% end %>
</div>
