<div data-controller="reprocess">
  <div data-reprocess-target="modal"
       class="fixed inset-0 z-50 flex items-center justify-center hidden"
       style="background: rgba(0,0,0,0.4);">
    <div class="bg-white rounded-xl shadow-xl px-10 py-8 flex flex-col items-center gap-4 max-w-sm w-full mx-4">
      <svg class="animate-spin text-green-camp" style="width:2rem;height:2rem" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
      <p class="font-serif font-semibold text-lg text-gray-800">Reprocessing receipt…</p>
      <p class="text-sm text-gray-500 text-center">Extracting vendor, date, and expense details.</p>
    </div>
  </div>

<div class="flex items-center gap-4 mb-6">
  <%= link_to "← Receipts", receipts_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <div class="flex-1"></div>
  <% if @receipt.file.attached? %>
    <button data-action="reprocess#start" data-url="<%= reprocess_receipt_path(@receipt) %>"
            class="text-sm text-blue-600 hover:underline bg-transparent border-0 cursor-pointer">
      Reprocess
    </button>
  <% end %>
  <%= link_to "Edit", edit_receipt_path(@receipt), class: "text-sm text-green-camp hover:underline" %>
  <%= button_to "Delete", @receipt, method: :delete, data: { turbo_confirm: "Delete this receipt?" }, class: "text-sm text-red-600 hover:underline bg-transparent border-0 cursor-pointer" %>
</div>

<div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
  <div class="flex items-start justify-between mb-4">
    <div>
      <h1 class="text-xl font-semibold"><%= @receipt.vendor %></h1>
      <p class="text-gray-500 text-sm mt-1"><%= @receipt.expense_date.strftime("%B %d, %Y") %></p>
    </div>
    <div class="flex items-center gap-3">
      <% if @receipt.approved_at.nil? %>
        <%= button_to "Approve Categorization", approve_receipt_path(@receipt), method: :post,
              class: "bg-teal-600 text-white px-3 py-1.5 rounded text-sm cursor-pointer hover:bg-teal-700" %>
      <% else %>
        <span class="text-xs text-gray-400">Categorized <%= @receipt.approved_at.strftime("%b %d") %></span>
      <% end %>
      <% if current_user.admin? %>
        <span class="inline-flex px-3 py-1 rounded-full text-sm font-medium <%= @receipt.matched? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
          <%= @receipt.status.capitalize %>
        </span>
      <% end %>
    </div>
  </div>

  <dl class="grid grid-cols-2 gap-4 text-sm">
    <div>
      <dt class="text-gray-500">Payment Method</dt>
      <dd class="font-medium mt-1"><%= @receipt.payment_method.display_name %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Submitted by</dt>
      <dd class="font-medium mt-1"><%= @receipt.user.name %></dd>
    </div>
    <% if @receipt.notes.present? %>
      <div class="col-span-2">
        <dt class="text-gray-500">Notes</dt>
        <dd class="mt-1"><%= @receipt.notes %></dd>
      </div>
    <% end %>
  </dl>
</div>

<div class="bg-white rounded-lg border border-gray-200 overflow-hidden mb-6">
  <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
    <h2 class="font-semibold">Expenses</h2>
  </div>
  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="text-left px-6 py-3 font-medium text-gray-600">Category</th>
        <th class="text-left px-6 py-3 font-medium text-gray-600">Description</th>
        <th class="text-right px-6 py-3 font-medium text-gray-600">Amount</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @receipt.expenses.each do |expense| %>
        <tr>
          <td class="px-6 py-3">
            <div class="text-xs text-gray-400"><%= expense.expense_category.section %></div>
            <div class="text-gray-600"><%= expense.expense_category.name %></div>
          </td>
          <td class="px-6 py-3"><%= expense.description %></td>
          <td class="px-6 py-3 text-right font-medium"><%= number_to_currency(expense.amount) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot class="border-t border-gray-200 bg-gray-50">
      <tr>
        <td colspan="2" class="px-6 py-3 font-semibold text-right">Total</td>
        <td class="px-6 py-3 text-right font-bold"><%= number_to_currency(@receipt.total_amount) %></td>
      </tr>
    </tfoot>
  </table>
</div>

<% if current_user.admin? && @receipt.charges.any? %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
      <h2 class="font-semibold">Matched Charges</h2>
      <% if @receipt.charges_total != @receipt.total_amount %>
        <span class="text-sm text-gray-500"><%= number_to_currency(@receipt.charges_total) %> of <%= number_to_currency(@receipt.total_amount) %></span>
      <% end %>
    </div>
    <table class="w-full text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="text-left px-6 py-3 font-medium text-gray-600">Date</th>
          <th class="text-left px-6 py-3 font-medium text-gray-600">Description</th>
          <th class="text-right px-6 py-3 font-medium text-gray-600">Amount</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @receipt.charges.each do |charge| %>
          <tr class="hover:bg-gray-50 cursor-pointer" data-controller="row-link" data-href="<%= admin_charge_path(charge) %>" data-action="click->row-link#navigate">
            <td class="px-6 py-3"><%= charge.transaction_date.strftime("%b %d, %Y") %></td>
            <td class="px-6 py-3 text-gray-600"><%= charge.description %></td>
            <td class="px-6 py-3 text-right font-medium"><%= number_to_currency(charge.amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @receipt.file.attached? %>
  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold">Attached Receipt</h2>
      <%= link_to "Download", rails_blob_path(@receipt.file, disposition: "attachment"), class: "text-sm text-green-camp hover:text-green-dark" %>
    </div>
    <% if @receipt.file.image? %>
      <%= image_tag @receipt.file, class: "max-w-md rounded border" %>
    <% elsif @receipt.file.content_type == "application/pdf" %>
      <iframe src="<%= rails_blob_path(@receipt.file, disposition: "inline") %>#navpanes=0"
              class="w-full rounded border border-gray-200"
              style="height: 700px;"
              title="Receipt PDF"></iframe>
    <% else %>
      <p class="text-sm text-gray-500">Preview not available for this file type.</p>
    <% end %>
  </div>
<% end %>

</div>
