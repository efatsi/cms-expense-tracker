<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-4">
    <h1 class="text-2xl font-serif font-semibold">
      <%= @filtered_user ? "#{@filtered_user.name}'s Receipts" : (@show_all ? "All Receipts" : "Receipts") %>
    </h1>
  </div>
  <div class="flex items-center gap-2">
    <% if current_user.admin? %>
      <%= link_to "Bulk Upload", bulk_upload_receipts_path, class: "border border-green-camp text-green-camp px-4 py-2 rounded-md text-sm font-medium hover:bg-green-50" %>
    <% end %>
    <%= link_to "New Receipt", new_receipt_path, class: "bg-green-camp text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-green-dark" %>
  </div>
</div>

<% if @restore_url %>
  <script>history.replaceState(null, "", "<%= raw @restore_url %>")</script>
<% end %>

<% if current_user.admin? %>
  <div class="flex items-center gap-4 mb-4">
    <%= form_with url: receipts_path, method: :get, class: "flex items-center gap-3" do |f| %>
      <%= select_tag :user_id,
            options_for_select([["All Employees", ""]] + @users.map { |u| [u.name, u.id] }, @filter_params[:user_id]),
            class: "border border-gray-300 rounded-md px-3 py-2 text-sm",
            onchange: "this.form.submit()" %>
      <label class="flex items-center gap-2 text-sm cursor-pointer">
        <%= check_box_tag :unmatched_charges, "1", @filter_params[:unmatched_charges].present?,
              class: "rounded", onchange: "this.form.submit()" %>
        Show unmatched only
      </label>
    <% end %>
  </div>
<% end %>

<% if @receipts.empty? %>
  <p class="text-gray-500 text-center py-12">No receipts yet. <%= link_to "Submit your first receipt", new_receipt_path, class: "text-green-camp hover:underline" %>.</p>
<% else %>
  <div id="receipts-list" data-controller="list-sort" data-list-sort-columns-value='[{"name":"col-date","attr":"data-sort-val"},{"name":"col-total","attr":"data-sort-val"},"col-employee","col-method","col-vendor","col-category","col-status","col-charges"]' class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <% if @show_all %>
            <th class="text-left px-4 py-3 font-medium text-gray-600">
              <button class="sort" data-sort="col-employee" data-list-sort-target="btn">
                Employee<span class="sort-icon text-gray-400"> ↕</span>
              </button>
            </th>
          <% end %>
          <th class="text-left px-4 py-3 font-medium text-gray-600">
            <button class="sort" data-sort="col-date" data-list-sort-target="btn">
              Date<span class="sort-icon text-gray-400"> ↕</span>
            </button>
          </th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">
            <button class="sort" data-sort="col-method" data-list-sort-target="btn">
              Payment Method<span class="sort-icon text-gray-400"> ↕</span>
            </button>
          </th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">
            <button class="sort" data-sort="col-vendor" data-list-sort-target="btn">
              Vendor<span class="sort-icon text-gray-400"> ↕</span>
            </button>
          </th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">
            <button class="sort" data-sort="col-category" data-list-sort-target="btn">
              Category<span class="sort-icon text-gray-400"> ↕</span>
            </button>
          </th>
          <th class="text-right px-4 py-3 font-medium text-gray-600">
            <button class="sort" data-sort="col-total" data-list-sort-target="btn">
              Total<span class="sort-icon text-gray-400"> ↕</span>
            </button>
          </th>
          <% if current_user.admin? %>
            <th class="text-left px-4 py-3 font-medium text-gray-600">
              <button class="sort" data-sort="col-status" data-list-sort-target="btn">
                Status<span class="sort-icon text-gray-400"> ↕</span>
              </button>
            </th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">
              <button class="sort" data-sort="col-charges" data-list-sort-target="btn">
                Charges<span class="sort-icon text-gray-400"> ↕</span>
              </button>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="list-tbody divide-y divide-gray-100">
        <% @receipts.each do |receipt| %>
          <tr class="hover:bg-gray-50 cursor-pointer" data-controller="row-link" data-href="<%= receipt_path(receipt) %>" data-action="click->row-link#navigate">
            <% if @show_all %>
              <td class="col-employee px-4 py-3 text-gray-700"><%= receipt.user.name %></td>
            <% end %>
            <td class="col-date px-4 py-3 text-gray-700" data-sort-val="<%= receipt.expense_date.strftime("%Y%m%d") %>">
              <%= receipt.expense_date.strftime("%b %d, %Y") %>
            </td>
            <td class="col-method px-4 py-3 text-gray-600"><%= receipt.payment_method.display_name %></td>
            <td class="col-vendor px-4 py-3 font-medium"><%= receipt.vendor %></td>
            <td class="col-category px-4 py-3">
              <% categories = receipt.expenses.map(&:expense_category).uniq %>
              <% categories.each do |cat| %>
                <div>
                  <div class="text-xs text-gray-400"><%= cat.section %></div>
                  <div class="text-sm"><%= cat.name %></div>
                </div>
              <% end %>
            </td>
            <td class="col-total px-4 py-3 text-right font-medium" data-sort-val="<%= format("%015.2f", receipt.total_amount.to_f) %>">
              <%= number_to_currency(receipt.total_amount) %>
            </td>
            <% if current_user.admin? %>
              <td class="col-status px-4 py-3">
                <% badge_class, badge_label = if receipt.matched?
                    [ "bg-green-100 text-green-800", "Matched" ]
                  elsif receipt.processing?
                    [ "bg-blue-100 text-blue-800", "Processing" ]
                  elsif receipt.approved_at.present?
                    [ "bg-teal-100 text-teal-800", "Categorized" ]
                  else
                    [ "bg-yellow-100 text-yellow-800 px-3", "Pending" ]
                  end %>
                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium <%= badge_class %>">
                  <%= badge_label %>
                </span>
              </td>
              <td class="col-charges px-4 py-3">
                <% charge_coverage = receipt.charges.sum(&:amount) %>
                <% if charge_coverage >= receipt.total_amount %>
                  <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Covered</span>
                <% elsif charge_coverage > 0 %>
                  <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-700">
                    <%= number_to_currency(charge_coverage) %> / <%= number_to_currency(receipt.total_amount) %>
                  </span>
                <% else %>
                  <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">No charges</span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
