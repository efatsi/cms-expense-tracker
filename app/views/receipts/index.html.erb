<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-4">
    <h1 class="text-2xl font-serif font-semibold">
      <%= @show_all ? "All Receipts" : "My Receipts" %>
    </h1>
    <% if current_user.admin? %>
      <%= link_to @show_all ? receipts_path : receipts_path(all: 1),
            class: "flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 select-none" do %>
        <span class="relative inline-flex h-5 w-9 rounded-full transition-colors <%= @show_all ? 'bg-green-camp' : 'bg-gray-300' %>">
          <span class="inline-block h-4 w-4 rounded-full bg-white shadow transform transition-transform mt-0.5 <%= @show_all ? 'translate-x-4' : 'translate-x-0.5' %>"></span>
        </span>
        Show all
      <% end %>
    <% end %>
  </div>
  <div class="flex items-center gap-2">
    <% if current_user.admin? %>
      <%= link_to "Bulk Upload", bulk_upload_receipts_path, class: "border border-green-camp text-green-camp px-4 py-2 rounded-md text-sm font-medium hover:bg-green-50" %>
    <% end %>
    <%= link_to "New Receipt", new_receipt_path, class: "bg-green-camp text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-green-dark" %>
  </div>
</div>

<% if @receipts.empty? %>
  <p class="text-gray-500 text-center py-12">No receipts yet. <%= link_to "Submit your first receipt", new_receipt_path, class: "text-green-camp hover:underline" %>.</p>
<% else %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <% if @show_all %>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Employee</th>
          <% end %>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Date</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Payment Method</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Vendor</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Category</th>
          <th class="text-right px-4 py-3 font-medium text-gray-600">Total</th>
          <% if current_user.admin? %>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Status</th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @receipts.each do |receipt| %>
          <tr class="hover:bg-gray-50 cursor-pointer" data-controller="row-link" data-href="<%= receipt_path(receipt) %>" data-action="click->row-link#navigate">
            <% if @show_all %>
              <td class="px-4 py-3 text-gray-700"><%= receipt.user.name %></td>
            <% end %>
            <td class="px-4 py-3 text-gray-700"><%= receipt.expense_date.strftime("%b %d, %Y") %></td>
            <td class="px-4 py-3 text-gray-600"><%= receipt.payment_method.display_name %></td>
            <td class="px-4 py-3 font-medium"><%= receipt.vendor %></td>
            <td class="px-4 py-3">
              <% categories = receipt.expenses.map(&:expense_category).uniq %>
              <% categories.each do |cat| %>
                <div>
                  <div class="text-xs text-gray-400"><%= cat.section %></div>
                  <div class="text-sm"><%= cat.name %></div>
                </div>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right font-medium"><%= number_to_currency(receipt.total_amount) %></td>
            <% if current_user.admin? %>
              <td class="px-4 py-3">
                <% badge_class, badge_label = if receipt.matched?
                    [ "bg-green-100 text-green-800", "Matched" ]
                  elsif receipt.processing?
                    [ "bg-blue-100 text-blue-800", "Processing" ]
                  elsif receipt.approved_at.present?
                    [ "bg-teal-100 text-teal-800", "Categorized" ]
                  else
                    [ "bg-yellow-100 text-yellow-800 px-3", "Pending" ]
                  end %>
                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium <%= badge_class %>">
                  <%= badge_label %>
                </span>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
