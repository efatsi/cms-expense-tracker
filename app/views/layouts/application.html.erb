<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Expense Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen">
    <nav class="bg-white border-b border-gray-200 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to "Expense Tracker", root_path, class: "font-semibold text-lg text-indigo-600" %>
          <% if user_signed_in? %>
            <%= link_to "My Receipts", receipts_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <%= link_to "Reports", reports_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
            <% if current_user.admin? %>
              <span class="text-gray-300">|</span>
              <%= link_to "Charges", admin_charges_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
              <%= link_to "Users", admin_users_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
              <%= link_to "Categories", admin_expense_categories_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
              <%= link_to "Payment Methods", admin_payment_methods_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
              <%= link_to "Admin Reports", admin_reports_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
            <% end %>
          <% end %>
        </div>
        <div class="flex items-center gap-4">
          <% if user_signed_in? %>
            <span class="text-sm text-gray-500"><%= current_user.name %></span>
            <%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <% else %>
            <%= link_to "Sign In", new_user_session_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-md text-sm"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-md text-sm"><%= alert %></div>
      </div>
    <% end %>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
