<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-serif font-semibold">AmEx Charges</h1>
  <div class="flex items-center gap-2">
    <%= link_to "Export CSV", export_admin_charges_path(request.query_parameters), class: "bg-white border border-gray-300 text-gray-700 px-4 py-1.5 rounded text-sm hover:bg-gray-50" %>
    <%= link_to "Import Statement", import_admin_charges_path, class: "bg-white border border-gray-300 text-gray-700 px-4 py-1.5 rounded text-sm hover:bg-gray-50" %>
  </div>
</div>

<div class="flex items-center gap-4 mb-4">
  <%= form_with url: admin_charges_path, method: :get, class: "flex items-center gap-3" do |f| %>
    <label class="flex items-center gap-2 text-sm cursor-pointer">
      <%= check_box_tag :unmatched_only, "1", params[:unmatched_only].present?, class: "rounded" %>
      Show unmatched only
    </label>
    <%= select_tag :payment_method_id,
          options_for_select([["Show All", ""]] + @payment_methods.map { |pm| [pm.name, pm.id] }, params[:payment_method_id]),
          class: "border border-gray-300 rounded-md px-3 py-2 text-sm",
          onchange: "this.form.submit()" %>
  <% end %>
</div>

<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="text-left px-4 py-3 font-medium text-gray-600">Date</th>
        <th class="text-left px-4 py-3 font-medium text-gray-600">Payment Method</th>
        <th class="text-left px-4 py-3 font-medium text-gray-600">Description</th>
        <th class="text-right px-4 py-3 font-medium text-gray-600">Amount</th>
        <th class="text-left px-4 py-3 font-medium text-gray-600">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @charges.each do |charge| %>
        <tr class="hover:bg-gray-50 cursor-pointer" data-controller="row-link" data-href="<%= admin_charge_path(charge) %>" data-action="click->row-link#navigate">
          <td class="px-4 py-3"><%= charge.transaction_date.strftime("%b %d, %Y") %></td>
          <td class="px-4 py-3 text-gray-600"><%= charge.payment_method.display_name %></td>
          <td class="px-4 py-3"><%= charge.description %></td>
          <td class="px-4 py-3 text-right font-medium"><%= number_to_currency(charge.amount) %></td>
          <td class="px-4 py-3">
            <% if charge.matched_at.present? %>
              <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Matched</span>
            <% else %>
              <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Unmatched</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @charges.empty? %>
    <p class="text-gray-500 text-center py-8">No charges found.</p>
  <% end %>
</div>
