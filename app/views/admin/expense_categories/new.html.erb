<div class="mb-6 flex items-center gap-4">
  <%= link_to "← Categories", admin_expense_categories_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="text-2xl font-semibold">New Category</h1>
</div>

<div class="bg-white rounded-lg border border-gray-200 p-6 max-w-sm">
  <%= form_with model: [:admin, @category] do |f| %>
    <% if @category.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-md text-sm mb-4">
        <%= @category.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div class="space-y-4">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
      </div>
      <label class="flex items-center gap-2 text-sm cursor-pointer">
        <%= f.check_box :active, class: "rounded" %>
        Active
      </label>
    </div>
    <div class="flex justify-end gap-3 mt-6">
      <%= link_to "Cancel", admin_expense_categories_path, class: "px-4 py-2 text-sm text-gray-600" %>
      <%= f.submit "Create", class: "bg-indigo-600 text-white px-6 py-2 rounded-md text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
