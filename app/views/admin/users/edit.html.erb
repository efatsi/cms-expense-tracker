<div class="mb-6 flex items-center gap-4">
  <%= link_to "← Users", admin_users_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="text-2xl font-semibold">Edit User</h1>
</div>

<div class="bg-white rounded-lg border border-gray-200 p-6 max-w-md">
  <%= form_with model: [:admin, @user] do |f| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-md text-sm mb-4">
        <ul class="list-disc pl-4">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :role, User.roles.keys.map { |r| [r.capitalize, r] },
              {}, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :default_payment_method_id, "Default Payment Method", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.collection_select :default_payment_method_id, PaymentMethod.order(:name), :id, :display_name,
              { include_blank: "None" }, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
      </div>
    </div>

    <div class="flex justify-end gap-3 mt-6">
      <%= link_to "Cancel", admin_users_path, class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-900" %>
      <%= f.submit "Save Changes", class: "bg-indigo-600 text-white px-6 py-2 rounded-md text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
