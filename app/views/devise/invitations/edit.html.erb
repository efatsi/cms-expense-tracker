<div class="max-w-sm mx-auto mt-16">
  <h2 class="text-2xl font-semibold mb-6">Set Your Password</h2>

  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <%= form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :invitation_token, readonly: true %>

      <div class="space-y-4">
        <% if f.object.class.require_password_on_accepting %>
          <div>
            <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-camp" %>
          </div>
          <div>
            <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-camp" %>
          </div>
        <% end %>
        <%= f.submit "Accept Invitation", class: "w-full bg-green-camp text-white py-2 rounded-md text-sm font-medium hover:bg-green-dark cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
