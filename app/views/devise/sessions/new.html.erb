<div class="max-w-sm mx-auto mt-16">
  <h2 class="text-2xl font-semibold mb-6 text-center">Sign In</h2>

  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-camp" %>
        </div>
        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password",
                class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-camp" %>
        </div>
        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2 text-sm cursor-pointer">
            <%= f.check_box :remember_me, class: "rounded" %>
            Remember me
          </label>
        <% end %>
        <%= f.submit "Sign In", class: "w-full bg-green-camp text-white py-2 rounded-md text-sm font-medium hover:bg-green-dark cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="mt-4 text-center text-sm text-gray-500">
    <%= render "devise/shared/links" %>
  </div>
</div>
